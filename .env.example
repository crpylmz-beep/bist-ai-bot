# Örnek; gerçek secret eklemeyin. Railway PORT değerini kendisi sağlar.
BIST_DATA_DIR=/data
PORT=8000
TZ=Europe/Istanbul
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
KAP_INTERVAL_SECONDS=60
MACRO_INTERVAL_SECONDS=120
ALARM_INTERVAL_SECONDS=30
PUSH_INTERVAL_SECONDS=20
INTRADAY_TOP10_INTERVAL_SECONDS=300
COMPANY_SITE_INTERVAL_SECONDS=900
FULL_SCAN_INTERVAL_SECONDS=30
PRIORITY_INTERVAL_SECONDS=2
YARIN_TOP10_INTERVAL_SECONDS=60
PERFORMANCE_INTERVAL_SECONDS=900
INTRADAY_PERFORMANCE_INTERVAL_SECONDS=300
MARKET_CONTEXT_INTERVAL_SECONDS=300
FULL_SCAN_BATCH_SIZE=10
COMPANY_SITE_BATCH_SIZE=15
COMPANY_SITE_DOMAIN_DELAY_SECONDS=2
PERFORMANCE_BATCH_SIZE=10
GUN_ICI_PERFORMANCE_BATCH_SIZE=10
MIN_LEARNING_SAMPLES=40
GUN_ICI_MIN_LEARNING_SAMPLES=40
LEARNING_ENABLED=false
GUN_ICI_LEARNING_ENABLED=false
YARIN_CALIBRATION_MAX_POINTS=3
NEWS_DEDUP_WINDOW_SECONDS=21600
MARKET_REGIME_MAX_EFFECT=0.75
BREADTH_MAX_EFFECT=0.75
SECTOR_RS_MAX_EFFECT=1
BREADTH_MIN_COVERAGE=0.6
BREADTH_MIN_STOCKS=30
SECTOR_RS_MIN_STOCKS=5
# BOT_TOKEN yalnızca Telegram için isteğe bağlı; web/worker için gerekli değil.

# İlk cloud analiz turu küçük batch, seans dışında da çalışır.
BOOTSTRAP_INTERVAL_SECONDS=30

# V6 depolama: bağlantı/provisioning ve production geçişi otomatik değildir.
STORAGE_BACKEND=legacy
STORAGE_POSTGRES_CUTOVER_ACK=false
STORAGE_BATCH_SIZE=100
STORAGE_POOL_SIZE=4
STORAGE_TIMEOUT_SECONDS=10
# BIST_POSTGRES_DSN veya DATABASE_URL güvenli environment üzerinden verilir.
# R2_ENDPOINT_URL, R2_BUCKET, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY environment üzerinden verilir.
# R2_PRIVATE_BUCKET_CONFIRMED=true ancak private bucket ayarı doğrulandıktan sonra.
